# Booking link used by every free-consultation button.
NEXT_PUBLIC_CALENDLY_URL=

# Resend delivers all contact and consultation submissions on the server.
RESEND_API_KEY=
RESEND_FROM_EMAIL="NeuraX Website <onboarding@resend.dev>"
CONTACT_RECIPIENT=chandibloom@gmail.com

# Set to false when the founding-client promotion should be hidden.
NEXT_PUBLIC_SHOW_FOUNDING_OFFER=true

# Google Analytics 4. It only loads after the visitor accepts analytics cookies.
NEXT_PUBLIC_GA_ID=G-KE1T5QTDDN

# Optional Google Search Console HTML verification token.
GOOGLE_SITE_VERIFICATION=

# Optional verified social profile URLs.
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_FACEBOOK_URL=
